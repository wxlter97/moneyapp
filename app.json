{
  "expo": {
    "name": "porksupuesto",
    "slug": "budget",
    "version": "1.7.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.wxlter.budget"
    },
    "android": {
      "package": "dev.wxlter.budget",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-system-ui",
        {
          "backgroundColor": "#111111"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "porksupuesto usa la cámara para fotografiar el recibo de una transacción.",
          "photosPermission": "porksupuesto accede a tus fotos para adjuntar el recibo de una transacción."
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "porksupuesto usa Face ID para desbloquear la app en vez de un PIN."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "porksupuesto usa el micrófono para dictar una transacción."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
