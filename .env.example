# Copiar a .env.local (git-ignored). Prefijo EXPO_PUBLIC_ => embebido en el bundle.

# Base del API REST del backend Django (incluye /api/v1).
# Web dev:            http://localhost:8000/api/v1
# iOS simulador:      http://localhost:8000/api/v1
# Dispositivo físico: http://<IP-LAN-de-tu-maquina>:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- "Continuar con Google" (opcional) ---
# Client IDs de OAuth (Google Cloud Console). Sin ninguno, el botón de
# Google simplemente no aparece en Iniciar sesión / Crear cuenta.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# --- Producción (Vercel) ---
# NO se pone aquí: se define en el panel de Vercel
# (Project -> Settings -> Environment Variables -> Production + Preview).
# Ver DEPLOY.md.
#   EXPO_PUBLIC_API_URL=https://<tu-servicio>.run.app/api/v1
