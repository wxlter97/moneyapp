# Copiar a .env.local (git-ignored). Prefijo EXPO_PUBLIC_ => embebido en el bundle.

# Base del API REST del backend Django (incluye /api/v1).
# Web dev:            http://localhost:8000/api/v1
# iOS simulador:      http://localhost:8000/api/v1
# Dispositivo físico: http://<IP-LAN-de-tu-maquina>:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- "Continuar con Google" (opcional) ---
# Client IDs de OAuth (Google Cloud Console). Sin ninguno, el botón de
# Google simplemente no aparece en Iniciar sesión / Crear cuenta.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

# --- Atajo de Apple Shortcuts (opcional) ---
# Link de iCloud del Atajo ya armado ("Compartir -> Copiar enlace de iCloud"
# desde la app Shortcuts en un iPhone). Sin esto, Herramientas -> Atajos sólo
# muestra las instrucciones para armarlo a mano. No se puede generar uno por
# usuario desde el backend: iOS sólo importa .shortcut firmados (AEA) y firmar
# requiere macOS; el token lo pide el propio Atajo al importarse.
# EXPO_PUBLIC_SHORTCUT_URL=https://www.icloud.com/shortcuts/xxxxxxxxxxxxxxxx

# --- Error tracking (Sentry, opcional) ---
# Vacío = Sentry.init() nunca se llama, cero overhead. Crear un proyecto
# React Native en sentry.io y pegar su DSN acá.
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oNNNN.ingest.sentry.io/NNNN

# --- Analítica sin cookies (Umami Cloud, opcional) ---
# Vacío = no se inyecta ningún script de analítica: la política de privacidad
# sigue siendo cierta tal cual está ("no usamos cookies ni rastreadores").
# Umami no usa cookies ni identifica personas -- crear un sitio gratis en
# https://cloud.umami.is y pegar acá su Website ID.
# EXPO_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Producción (Vercel) ---
# NO se pone aquí: se define en el panel de Vercel
# (Project -> Settings -> Environment Variables -> Production + Preview).
# Ver DEPLOY.md.
#   EXPO_PUBLIC_API_URL=https://<tu-servicio>.run.app/api/v1
